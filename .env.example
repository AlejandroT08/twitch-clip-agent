# ==========================================
# CONFIGURACIÓN DE CREDENCIALES (API KEYS)
# Renombra este archivo a .env y llena tus datos
# ==========================================

# 1. TWITCH DEVELOPER API (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID="tu_twitch_client_id_aqui"
TWITCH_CLIENT_SECRET="tu_twitch_client_secret_aqui"

# 2. HIGGSFIELD AI API (https://open.higgsfield.ai)
# Formato: "KEY_ID:KEY_SECRET"
HF_KEY="tu_key_id:tu_key_secret"

# 3. PROVEEDOR LLM PARA OPTIMIZAR TOKENS (Elige uno)
# Recomendado por ultra bajo coste: Gemini Flash
GEMINI_API_KEY="tu_gemini_api_key_aqui"
# O si prefieres OpenAI:
OPENAI_API_KEY=""

# 4. YOUTUBE SHORTS (Google Cloud Console OAuth 2.0)
# Descarga el archivo JSON de tu cliente OAuth2 y pon el nombre aquí
YOUTUBE_CLIENT_SECRETS_FILE="client_secret.json"

# 5. TIKTOK (Archivo de cookies exportado con extensión de navegador)
TIKTOK_COOKIES_FILE="tiktok_cookies.txt"
